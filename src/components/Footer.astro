---
import { NAVIGATION_LINKS, COMPANY_INFO, CONTACT_INFO, telLink } from '../lib/site';
---

<footer class="bg-gray-900 text-gray-300 pt-16 pb-8 mt-auto">
  <div class="container-custom grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <p class="text-white font-bold text-xl mb-3">{COMPANY_INFO.name}</p>
      <p class="text-sm leading-relaxed">{COMPANY_INFO.description}</p>
    </div>

    <div>
      <p class="text-white font-semibold mb-4">Services</p>
      <ul class="space-y-2 text-sm">
        {NAVIGATION_LINKS.services.map((link) => (
          <li><a href={link.href} class="inline-block py-1 hover:text-white transition-colors">{link.name}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-white font-semibold mb-4">Pakistan Destinations</p>
      <ul class="space-y-2 text-sm">
        {NAVIGATION_LINKS.pakistanCities.slice(0, 6).map((link) => (
          <li><a href={link.href} class="inline-block py-1 hover:text-white transition-colors">{link.name}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-white font-semibold mb-4">Contact</p>
      <ul class="space-y-3 text-sm">
        <li>
          <a href={telLink()} class="hover:text-white transition-colors">{COMPANY_INFO.phone}</a>
        </li>
        <li>
          <a href={`mailto:${COMPANY_INFO.email}`} class="hover:text-white transition-colors">{COMPANY_INFO.email}</a>
        </li>
        <li>{COMPANY_INFO.address}</li>
      </ul>
    </div>
  </div>

  <div class="container-custom mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs">
    <p>&copy; {new Date().getFullYear()} {COMPANY_INFO.name}. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="/sitemap-index.xml" class="inline-block py-2 hover:text-white transition-colors">Sitemap</a>
    </div>
  </div>
</footer>
