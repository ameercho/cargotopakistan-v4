---
interface Props {
  heading: string;
  faqs?: { question: string; answer: string }[];
}

const { heading, faqs } = Astro.props;
---

{faqs && faqs.length > 0 && (
  <div class="mt-10 not-prose">
    <h2 class="text-2xl font-bold text-cargo-blue mb-4">{heading}</h2>
    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-5">
          <h3 class="font-semibold text-gray-900 mb-2">{faq.question}</h3>
          <p class="text-gray-600">{faq.answer}</p>
        </div>
      ))}
    </div>
  </div>
)}
