---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 Not Found | Cargo to Pakistan"
  description="The page you are looking for does not exist. Return to the homepage or contact us for help."
  noindex={true}
>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-cargo-blue mb-4">404</h1>
      <p class="text-lg text-gray-600 mb-8">This page does not exist. Go back to the homepage or contact support.</p>
      <div class="flex gap-4 justify-center">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/contact/" class="btn-outline border-cargo-blue text-cargo-blue">Contact Us</a>
      </div>
    </div>
  </div>
</Layout>
