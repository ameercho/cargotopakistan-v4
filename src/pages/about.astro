---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../lib/site';

// References the same canonical entity declared in Layout.astro rather than
// re-declaring name/address/areaServed with different (and now conflicting)
// values — foundingDate is the only fact this page adds that isn't already
// on the sitewide node.
const schema = {
  '@context': 'https://schema.org',
  '@id': `${COMPANY_INFO.website}/#organization`,
  foundingDate: '2015',
};

const values = [
  { title: 'Reliability', desc: 'We deliver on our promises, ensuring your cargo reaches Pakistan safely and on time.' },
  { title: 'Transparency', desc: 'Clear communication and honest pricing are at the heart of our Pakistan shipping business.' },
  { title: 'Customer Focus', desc: 'Your UAE to Pakistan shipping needs drive our service offerings and improvements.' },
  { title: 'Excellence', desc: 'We continuously strive to improve and deliver the best possible Pakistan cargo service.' },
];

const stats = [
  { icon: 'users', value: '10,000+', label: 'Happy Customers' },
  { icon: 'map', value: '25+', label: 'Pakistan Cities Served' },
  { icon: 'shield-check', value: '99%', label: 'Delivery Success Rate' },
  { icon: 'award', value: '9+', label: 'Years Experience' },
];
---

<Layout
  title="About Us | Cargo to Pakistan Shipping Company Since 2015"
  description="Cargo to Pakistan has provided reliable, affordable cargo shipping from UAE to Pakistan since 2015. Learn about our story, values, and coverage."
  keywords="about cargo to pakistan, uae pakistan shipping company, pakistan cargo history"
  structuredData={schema}
>
  <section class="hero-gradient py-16">
    <div class="container-custom">
      <span class="inline-block bg-white/20 px-4 py-1 rounded-full text-sm mb-4">Trusted Since 2015</span>
      <h1 class="text-3xl md:text-5xl font-bold mb-4">About Cargo to Pakistan</h1>
      <p class="text-lg text-gray-100 max-w-2xl">
        Your trusted partner for reliable and professional cargo services from UAE to Pakistan.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-cargo-blue mb-6">Our Story</h2>
        <p class="text-gray-600 mb-4 text-lg">
          Cargo to Pakistan was founded in 2015 with a clear mission: to provide reliable, efficient, and
          affordable cargo services from UAE to Pakistan. What started as a small operation has grown into
          a trusted name in the UAE Pakistan shipping industry.
        </p>
        <p class="text-gray-600 mb-6">
          Today, we serve thousands of customers annually, helping them connect with family, friends, and
          business partners in Pakistan through comprehensive Dubai, Abu Dhabi, and Sharjah to Pakistan
          cargo solutions.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/services/" class="btn-primary">Our Services</a>
          <a href="/contact/" class="btn-outline border-cargo-green text-cargo-green">Contact Us</a>
        </div>
      </div>
      <div class="bg-gray-50 p-8 rounded-xl">
        <h3 class="text-2xl font-bold text-cargo-blue mb-6">Our Core Values</h3>
        <div class="space-y-4">
          {values.map((v) => (
            <div class="flex items-start gap-3">
              <Icon name="lucide:check-circle" class="w-6 h-6 text-cargo-green mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-cargo-blue">{v.title}</h4>
                <p class="text-gray-600 text-sm">{v.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section bg-gray-50">
    <div class="container-custom">
      <h2 class="text-3xl font-bold text-cargo-blue mb-12 text-center">Our Impact</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div class="bg-white p-6 rounded-xl text-center shadow-sm border border-gray-100">
            <Icon name={`lucide:${s.icon}`} class="w-8 h-8 text-cargo-blue mx-auto mb-3" />
            <div class="text-3xl font-bold text-cargo-blue mb-1">{s.value}</div>
            <div class="text-gray-600 text-sm">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section bg-cargo-green text-white text-center">
    <div class="container-custom">
      <h2 class="text-3xl font-bold mb-4">Ready to Experience Our Service?</h2>
      <p class="text-lg mb-8 max-w-xl mx-auto">Join thousands of satisfied customers who trust us with their cargo.</p>
      <a href="/contact/" class="btn bg-white text-cargo-green hover:bg-gray-100">Get Free Quote</a>
    </div>
  </section>
</Layout>
