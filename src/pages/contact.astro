---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO, FORMSPREE_ENDPOINT, whatsappLink } from '../lib/site';

// Additional lines alongside the primary number — all ring the same team.
const ADDITIONAL_PHONE_NUMBERS = ['+971585847087', '+971585817087'];
const ALL_PHONE_NUMBERS = [COMPANY_INFO.phone, ...ADDITIONAL_PHONE_NUMBERS];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Cargo to Pakistan',
  description: 'Get in touch with our expert team for professional cargo shipping services from UAE to Pakistan',
  mainEntity: {
    '@id': `${COMPANY_INFO.website}/#organization`,
    contactPoint: ALL_PHONE_NUMBERS.map((phone) => ({
      '@type': 'ContactPoint',
      telephone: phone,
      contactType: 'customer service',
      areaServed: 'AE',
      availableLanguage: ['en'],
    })),
  },
};
---

<Layout
  title="Contact Us | Cargo to Pakistan"
  description="Contact our expert team for professional cargo shipping services from UAE to Pakistan. Get a free quote via phone, WhatsApp, or our contact form."
  keywords="contact cargo to pakistan, pakistan cargo quote, dubai cargo contact"
  h1="Contact Us for Professional Pakistan Cargo Services"
  structuredData={schema}
>
  <section class="hero-gradient py-16">
    <div class="container-custom">
      <span class="inline-block bg-white/20 px-4 py-1 rounded-full text-sm mb-4">24/7 Customer Support</span>
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Contact Cargo to Pakistan</h1>
      <p class="text-lg text-gray-100 max-w-2xl">
        Get in touch with our expert team for professional cargo shipping services from UAE to Pakistan.
        We're here to help with quotes, questions, and support.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container-custom grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
          <Icon name="lucide:phone" class="w-8 h-8 text-cargo-blue mb-3" />
          <h3 class="font-semibold text-lg mb-2">Call Us Now</h3>
          <p class="text-gray-600 text-sm mb-3">Speak directly with our Pakistan cargo experts.</p>
          <div class="flex flex-col gap-1">
            {ALL_PHONE_NUMBERS.map((phone) => (
              <a href={`tel:${phone}`} class="text-cargo-blue font-semibold">{phone}</a>
            ))}
          </div>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
          <Icon name="lucide:message-circle" class="w-8 h-8 text-cargo-green mb-3" />
          <h3 class="font-semibold text-lg mb-2">WhatsApp</h3>
          <p class="text-gray-600 text-sm mb-3">Quick responses for your shipping queries.</p>
          <a href={whatsappLink('Hello, I have a question about shipping cargo to Pakistan.')} target="_blank" rel="noopener noreferrer" class="text-cargo-blue font-semibold">Chat on WhatsApp</a>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
          <Icon name="lucide:mail" class="w-8 h-8 text-cargo-blue mb-3" />
          <h3 class="font-semibold text-lg mb-2">Email Support</h3>
          <p class="text-gray-600 text-sm mb-3">Send detailed inquiries about your cargo requirements.</p>
          <a href={`mailto:${COMPANY_INFO.email}`} class="text-cargo-blue font-semibold">{COMPANY_INFO.email}</a>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
          <Icon name="lucide:map-pin" class="w-8 h-8 text-cargo-blue mb-3" />
          <h3 class="font-semibold text-lg mb-2">Warehouse Address</h3>
          <p class="text-gray-600 text-sm mb-3">Pickup service is available in Dubai, Abu Dhabi, Sharjah, Ajman and across the UAE.</p>
          <p class="text-cargo-blue font-semibold">{COMPANY_INFO.address}</p>
        </div>
      </div>

      <div class="bg-white shadow-lg rounded-xl p-6 md:p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Send Us a Message</h2>
        <form name="contact" method="POST" data-formspree action={FORMSPREE_ENDPOINT} class="space-y-4">
          <input type="hidden" name="_subject" value="New contact form message - cargotopakistan.ae" />
          <input type="hidden" name="form-name" value="contact" />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="name">Name</label>
              <input id="name" name="name" type="text" required minlength="2" class="w-full rounded-lg border border-gray-300 px-4 py-2.5" placeholder="Muhammad" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Email</label>
              <input id="email" name="email" type="email" required class="w-full rounded-lg border border-gray-300 px-4 py-2.5" placeholder="you@example.com" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" required minlength="10" class="w-full rounded-lg border border-gray-300 px-4 py-2.5" placeholder="+971 50 1234 567" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1" for="inquiry">Inquiry Type</label>
              <select id="inquiry" name="inquiry" required class="w-full rounded-lg border border-gray-300 px-4 py-2.5">
                <option value="">Select inquiry type</option>
                <option value="quote">Get a Quote</option>
                <option value="service">Service Inquiry</option>
                <option value="support">Customer Support</option>
                <option value="feedback">Feedback</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="subject">Subject</label>
            <input id="subject" name="subject" type="text" required minlength="2" class="w-full rounded-lg border border-gray-300 px-4 py-2.5" placeholder="How can we help you?" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="message">Message</label>
            <textarea id="message" name="message" required minlength="10" rows="4" class="w-full rounded-lg border border-gray-300 px-4 py-2.5" placeholder="Please provide details about your inquiry..."></textarea>
            <p class="text-xs text-gray-500 mt-1">Your message will be responded to within 24 hours.</p>
          </div>

          <button type="submit" class="btn-primary w-full">Send Message</button>
          <p data-form-status role="alert" class="text-sm text-red-600"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initFormspreeForms } from '../lib/formspree';
  initFormspreeForms();
</script>
